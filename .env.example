# Replit PostgreSQL or another managed PostgreSQL connection string.
DATABASE_URL=

# Optional transactional email delivery through Resend.
RESEND_API_KEY=
FROM_EMAIL=Weeboo <hello@weeboo.com>
LEAD_NOTIFICATION_EMAIL=hello@weeboo.com

# Comma-separated production origins. Same-host requests are always accepted.
PUBLIC_ORIGIN=https://weeboo.com,https://www.weeboo.com

# Runtime settings.
NODE_ENV=production
PORT=3000
